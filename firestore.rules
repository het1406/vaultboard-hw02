rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function owner(uid) { return signedIn() && request.auth.uid == uid; }
  function validText(s) { return s is string && s.size() > 0 && s.size() <= 2000 && s.matches('[\\s\\S]*[^\\s][\\s\\S]*'); }
  match /users/{uid} {
   allow get: if owner(uid);
   allow create: if owner(uid) && request.resource.data.keys().hasOnly(['uid','firstName','lastName','role','registrationDateTime'])
     && request.resource.data.uid == uid && request.resource.data.role == 'member'
     && request.resource.data.firstName is string && request.resource.data.firstName.size() > 0 && request.resource.data.firstName.size() <= 60
     && request.resource.data.lastName is string && request.resource.data.lastName.size() > 0 && request.resource.data.lastName.size() <= 60
     && request.resource.data.registrationDateTime == request.time;
   match /postReceipts/{id} {
    allow get: if owner(uid);
    allow create: if owner(uid) && request.resource.data.keys().hasOnly(['messageId','createdAt'])
      && request.resource.data.messageId == id && request.resource.data.createdAt == request.time
      && !exists(/databases/$(database)/documents/messages/$(id))
      && getAfter(/databases/$(database)/documents/messages/$(id)).data.authorUid == uid;
   }
  }
  match /messages/{id} {
   allow read: if signedIn();
   allow create: if signedIn() && request.resource.data.keys().hasOnly(['text','authorUid','authorName','createdAt','editedAt'])
     && owner(request.resource.data.authorUid) && validText(request.resource.data.text)
     && request.resource.data.authorName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.firstName + ' ' + get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastName
     && request.resource.data.createdAt == request.time && request.resource.data.editedAt == null
     && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/postReceipts/$(id))
     && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/postReceipts/$(id)).data.messageId == id;
   allow update: if owner(resource.data.authorUid)
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','editedAt'])
     && validText(request.resource.data.text) && request.resource.data.editedAt == request.time;
   allow delete: if owner(resource.data.authorUid);
  }
 }
}
